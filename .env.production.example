# Скопируйте в .env.production и заполните. Файл с секретами НЕ коммитить.
DOMAIN=journal.example.kz
APP_URL=https://journal.example.kz

# Пароль БД: длинная случайная строка, например: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=journal
POSTGRES_DB=journal
POSTGRES_PASSWORD=

# Вход через Google (Google Cloud Console → OAuth client, тип Web application;
# Authorized redirect URI: https://<DOMAIN>/auth/google/callback). Пусто — только вход по паролю.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Домены Google Workspace школы через запятую: сотрудники и ученики входят только с них
GOOGLE_ALLOWED_DOMAINS=

# Сеансы: максимальный срок (дни) и бездействие (часы)
SESSION_DAYS=14
SESSION_IDLE_HOURS=72

# Только для демо-стенда с вымышленными данными! В рабочей версии — false.
DEMO_MODE=false

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
